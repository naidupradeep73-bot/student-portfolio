SECRET_KEY=replace-with-a-long-random-secret
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/student_portfolio
MONGO_DB=student_portfolio
# Set to true only for local UI development without MongoDB. Data resets when the server stops.
USE_IN_MEMORY_DB=false
MAX_CONTENT_LENGTH=16777216
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
